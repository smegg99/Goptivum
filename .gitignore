# Build output and local runtime state
bin/
tmp/
logs/
.env
/config.yaml
# What an administrator changes while the server runs, written beside
# config.yaml by the server itself.
/settings.yaml
# The daemon's own defaults when nothing configures it: a local database and a
# local object directory.
goptivum.db
goptivum.db-*
/documents/
# This deployment's own keypair for the solving nodes. A node pins the
# certificate in here, so it is local state and never shared.
arrango-identity/

node_modules/
__pycache__/
*.log

# The bundled contract is versioned for API consumers.
!contracts/dist/

# Real files: personal data, never committed.
tests/data/

# Stray build output
/plaprobe
